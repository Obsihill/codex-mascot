<UserControl x:Class="CodexMascot.App.LibraryDashboard"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:CodexMascot.App"
 Background="#F5F6F8" Foreground="#263240" FontFamily="Segoe UI" FontSize="13" PreviewKeyDown="History_OnKeyDown">
 <UserControl.Resources>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#263240"/></Style>
  <Style TargetType="TextBox"><Setter Property="Foreground" Value="#263240"/><Setter Property="Background" Value="White"/><Setter Property="Padding" Value="8"/><Setter Property="BorderBrush" Value="#D9DFE5"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#263240"/><Setter Property="Padding" Value="8"/></Style>
  <Style TargetType="Button">
   <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#263240"/>
   <Setter Property="BorderBrush" Value="#D9DFE5"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="14,9"/><Setter Property="Margin" Value="0"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="Opacity" Value=".75"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Box" Property="Opacity" Value=".4"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="CardAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Width" Value="24"/><Setter Property="Height" Value="24"/>
   <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="2"/>
   <Setter Property="FontSize" Value="18"/><Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="VerticalAlignment" Value="Top"/>
  </Style>
  <Style TargetType="ListBoxItem">
   <Setter Property="Margin" Value="5"/><Setter Property="Padding" Value="0"/>
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
    <Border x:Name="Card" Background="White" BorderBrush="#E4E8ED" BorderThickness="1" CornerRadius="12" Padding="10">
     <ContentPresenter/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Background" Value="#F3F8F7"/></Trigger>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#328C79"/><Setter TargetName="Card" Property="Background" Value="#EFF8F5"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <DataTemplate x:Key="MascotCard">
   <StackPanel Width="126">
    <Grid Height="88"><Border Background="#F5F6F8" CornerRadius="8"/>
     <Image Source="{Binding Thumbnail}" Margin="5" Stretch="Uniform"/>
     <Button x:Name="CardAddButton" Style="{StaticResource CardAction}" Content="+" Foreground="#328C79" ToolTip="추가" AutomationProperties.Name="{Binding Name, StringFormat={}{0} 추가}" Click="CardAdd_OnClick"/>
    </Grid>
    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="2,10,0,3" TextTrimming="CharacterEllipsis"/>
   </StackPanel>
  </DataTemplate>
  <DataTemplate x:Key="SelectedMascotCard">
   <Grid Width="198"><Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Grid Height="64">
     <Border Background="#F5F6F8" CornerRadius="8"><Image Source="{Binding Thumbnail}" Margin="4" Stretch="Uniform"/></Border>
     <Button x:Name="CardRemoveButton" Style="{StaticResource CardAction}" Content="−" Foreground="#B63C49" ToolTip="선택 해제" AutomationProperties.Name="{Binding Name, StringFormat={}{0} 선택 해제}" Click="CardRemove_OnClick"/>
    </Grid>
    <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
   </Grid>
  </DataTemplate>
 </UserControl.Resources>
 <Grid Margin="28,24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="Mascot studio" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,22"/>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
   <Grid><Grid.RowDefinitions><RowDefinition x:Name="InstalledRow" Height="4*" MinHeight="165"/><RowDefinition Height="18"/><RowDefinition x:Name="SelectedRow" Height="3*" MinHeight="135"/></Grid.RowDefinitions>
    <GridSplitter x:Name="LibrarySplitter" Grid.Row="1" Height="12" HorizontalAlignment="Stretch" VerticalAlignment="Center" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Background="Transparent" DragCompleted="Splitter_OnDragCompleted" KeyUp="Splitter_OnKeyUp" Cursor="SizeNS">
     <GridSplitter.Template><ControlTemplate TargetType="GridSplitter"><Grid Background="Transparent"><Border Width="40" Height="3" CornerRadius="2" Background="#C7D0D6" VerticalAlignment="Center" HorizontalAlignment="Center"/></Grid></ControlTemplate></GridSplitter.Template>
    </GridSplitter>
    <Border Background="White" BorderBrush="#E0E5EB" BorderThickness="1" CornerRadius="14" Padding="16">
     <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel Margin="3,0,3,12"><TextBlock x:Name="InstalledCount" DockPanel.Dock="Right" Foreground="#7A8694" VerticalAlignment="Center" Margin="12,0,0,0"/><ComboBox x:Name="InstalledSort" DockPanel.Dock="Right" Width="112" Padding="6,4" SelectionChanged="Sort_OnChanged" ToolTip="설치됨 정렬"/><TextBlock Text="설치됨" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
      <ListBox x:Name="InstalledList" Grid.Row="1" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemTemplate="{StaticResource MascotCard}" SelectionChanged="Installed_OnSelectionChanged" PreviewMouseLeftButtonDown="List_OnMouseDown" PreviewMouseMove="List_OnMouseMove" MouseDoubleClick="Installed_OnDoubleClick">
       <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
      </ListBox>
      <Button x:Name="DeleteButton" Grid.Row="2" Content="삭제" Foreground="#B63C49" Margin="3,12,3,0" HorizontalAlignment="Right" Click="Delete_OnClick"/>
     </Grid>
    </Border>
    <Border x:Name="DropZone" Grid.Row="2" Background="White" BorderBrush="#CBD8D3" BorderThickness="1" CornerRadius="14" Padding="16" AllowDrop="True" DragOver="Selected_OnDragOver" DragLeave="Selected_OnDragLeave" Drop="Selected_OnDrop">
     <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <DockPanel Margin="3,0,3,12"><TextBlock x:Name="SelectedCount" DockPanel.Dock="Right" Foreground="#7A8694"/><TextBlock Text="선택됨" FontSize="16" FontWeight="SemiBold"/></DockPanel>
      <ListBox x:Name="SelectedList" Grid.Row="1" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemTemplate="{StaticResource SelectedMascotCard}" SelectionChanged="Selected_OnSelectionChanged" PreviewMouseLeftButtonDown="List_OnMouseDown" PreviewMouseMove="List_OnMouseMove" MouseDoubleClick="Selected_OnDoubleClick">
       <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
      </ListBox>
     </Grid>
    </Border>
   </Grid>
   <Border Grid.Column="2" Background="White" BorderBrush="#E0E5EB" BorderThickness="1" CornerRadius="14" Padding="20">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
     <Border Background="#F4F6F8" CornerRadius="12" Height="194" Margin="0,0,0,14">
      <Grid><Image x:Name="PreviewImage" Margin="12" Stretch="Uniform"/><MediaElement x:Name="PreviewVideo" Visibility="Collapsed" LoadedBehavior="Manual" UnloadedBehavior="Close" Stretch="Uniform" IsMuted="True"/><TextBlock x:Name="PreviewError" TextWrapping="Wrap" Margin="16" VerticalAlignment="Center" TextAlignment="Center" Visibility="Collapsed"/></Grid>
     </Border>
     <TextBlock x:Name="DetailName" FontSize="19" FontWeight="SemiBold"/>
     <DockPanel Margin="0,12,0,12"><Button x:Name="StateSettingsButton" DockPanel.Dock="Right" Content="상태별 설정" Padding="10,6" Click="StateSettings_OnClick"/><TextBlock x:Name="ScopeLabel" Text="전체" VerticalAlignment="Center"/></DockPanel>
     <ComboBox x:Name="PreviewState" Visibility="Collapsed" Margin="0,0,0,16" SelectionChanged="PreviewState_OnChanged"/>
     <StackPanel x:Name="EditorPanel">
      <local:NumericDragInput x:Name="VolumeInput" Label="볼륨" Minimum="0" Maximum="2" DisplayScale="100" UnitsPerPixel=".5" Suffix="%" Margin="0,0,0,12" ValueCommitted="Volume_OnChanged"/>
      <local:NumericDragInput x:Name="SpeedInput" Label="재생 속도" Minimum=".25" Maximum="3" DecimalPlaces="2" UnitsPerPixel=".01" Suffix="×" Margin="0,0,0,16" ValueCommitted="Speed_OnChanged"/>
      <local:NumericDragInput x:Name="DurationInput" Label="이미지 재생시간" Minimum="0" Maximum="600000" DisplayScale=".001" DecimalPlaces="1" UnitsPerPixel=".1" Suffix="초" Margin="0,0,0,16" ValueCommitted="Duration_OnChanged"/>
      <WrapPanel x:Name="StatePlaybackOptions" Visibility="Collapsed" Margin="0,0,0,12"><CheckBox x:Name="PlayCheck" Content="재생" Margin="0,0,12,0" Click="Play_OnClick"/><CheckBox x:Name="LoopCheck" Content="반복" Click="Loop_OnClick"/></WrapPanel>
      <Button x:Name="PositionButton" Content="위치 선택" Margin="0,8,0,16" Click="Position_OnClick"/>
      <Button x:Name="TestButton" Content="▶ 테스트" Click="Test_OnClick" Background="#328C79" Foreground="White" BorderBrush="#328C79"/>
      <Button x:Name="ResetSettingsButton" Content="설정 초기화" Margin="0,12,0,0" Click="ResetSettings_OnClick"/>
     </StackPanel>
    </StackPanel></ScrollViewer>
   </Border>
  </Grid>
  <DockPanel Grid.Row="2" Margin="0,20,0,0" HorizontalAlignment="Right">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="RegisterButton" Content="＋ 마스코트 등록" Click="Register_OnClick" Background="#263F38" Foreground="White" BorderBrush="#263F38"/><Button Content="설정" Click="Settings_OnClick" Margin="10,0,0,0"/></StackPanel>
  </DockPanel>
  <TextBlock x:Name="Feedback" Grid.Row="3" MinHeight="18" Margin="0,12,0,0" Foreground="#697889" TextTrimming="CharacterEllipsis"/>
 </Grid>
</UserControl>
