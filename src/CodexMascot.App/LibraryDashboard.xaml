<UserControl x:Class="CodexMascot.App.LibraryDashboard"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:CodexMascot.App"
 Background="{x:Static local:PencilPalette.Paper}" Foreground="{x:Static local:PencilPalette.Ink}" FontFamily="{x:Static local:PencilFonts.Handwriting}" FontSize="20" PreviewKeyDown="History_OnKeyDown">
 <UserControl.Resources>
 <ResourceDictionary>
  <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="PencilTheme.xaml"/></ResourceDictionary.MergedDictionaries>
  <Style x:Key="CardAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Width" Value="24"/><Setter Property="Height" Value="24"/>
   <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="2"/>
   <Setter Property="FontSize" Value="18"/><Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="VerticalAlignment" Value="Top"/>
  </Style>
  <Style TargetType="ListBoxItem">
   <Setter Property="Margin" Value="5"/><Setter Property="Padding" Value="0"/>
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
    <local:PencilBorder x:Name="Card" Background="{x:Static local:PencilPalette.Surface}" BorderBrush="{x:Static local:PencilPalette.Line}" BorderThickness="1" CornerRadius="12" Padding="10">
     <ContentPresenter/>
    </local:PencilBorder>
    <ControlTemplate.Triggers>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{x:Static local:PencilPalette.Accent}"/></Trigger>
     <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{x:Static local:PencilPalette.Accent}"/></Trigger>
     <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsEnabled" Value="True"/></MultiTrigger.Conditions><Setter TargetName="Card" Property="BorderBrush" Value="{x:Static local:PencilPalette.Emphasis}"/></MultiTrigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="CardBody" TargetType="local:PencilBorder">
   <Setter Property="Width" Value="126"/><Setter Property="Height" Value="126"/><Setter Property="Background" Value="{x:Static local:PencilPalette.Inset}"/>
   <Setter Property="BorderBrush" Value="{x:Static local:PencilPalette.Line}"/><Setter Property="BorderThickness" Value="1"/>
  </Style>
  <Style x:Key="CardCaption" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
   <Setter Property="VerticalAlignment" Value="Bottom"/><Setter Property="TextAlignment" Value="Center"/>
   <Setter Property="Margin" Value="5,0,5,7"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/>
   <Setter Property="Panel.ZIndex" Value="1"/>
   <Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#FCFAF4" BlurRadius="3" ShadowDepth="0" Opacity="1"/></Setter.Value></Setter>
  </Style>
  <Style x:Key="CardImage" TargetType="Image">
   <Setter Property="Stretch" Value="Uniform"/><Setter Property="RenderTransformOrigin" Value=".5,.5"/>
   <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality"/>
   <Setter Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="1" ScaleY="1"/></Setter.Value></Setter>
   <Style.Triggers>
    <MultiDataTrigger>
     <MultiDataTrigger.Conditions>
      <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"/>
      <Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"/>
     </MultiDataTrigger.Conditions>
     <MultiDataTrigger.EnterActions><BeginStoryboard><Storyboard>
      <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.15" Duration="0:0:0.12"/>
      <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.15" Duration="0:0:0.12"/>
     </Storyboard></BeginStoryboard></MultiDataTrigger.EnterActions>
     <MultiDataTrigger.ExitActions><BeginStoryboard><Storyboard>
      <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.12"/>
      <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.12"/>
     </Storyboard></BeginStoryboard></MultiDataTrigger.ExitActions>
    </MultiDataTrigger>
   </Style.Triggers>
  </Style>
  <DataTemplate x:Key="MascotCard">
   <local:PencilBorder x:Name="CardBody" Style="{StaticResource CardBody}">
    <Grid ClipToBounds="True">
     <Image Source="{Binding Thumbnail}" Style="{StaticResource CardImage}"/>
     <TextBlock x:Name="CardCaption" Style="{StaticResource CardCaption}" Text="{Binding Name}" ToolTip="{Binding Name}"/>
     <Button x:Name="CardAddButton" Panel.ZIndex="2" Style="{StaticResource CardAction}" Content="" local:Pencil.Icon="Add" Foreground="{x:Static local:PencilPalette.Accent}" ToolTip="추가" AutomationProperties.Name="{Binding Name, StringFormat={}{0} 추가}" Click="CardAdd_OnClick"/>
    </Grid>
   </local:PencilBorder>
  </DataTemplate>
  <DataTemplate x:Key="SelectedMascotCard">
   <local:PencilBorder x:Name="CardBody" Style="{StaticResource CardBody}">
    <Grid ClipToBounds="True">
     <Image Source="{Binding Thumbnail}" Style="{StaticResource CardImage}"/>
     <TextBlock x:Name="CardCaption" Style="{StaticResource CardCaption}" Text="{Binding Name}" ToolTip="{Binding Name}"/>
     <Button x:Name="CardRemoveButton" Panel.ZIndex="2" Style="{StaticResource CardAction}" Content="" local:Pencil.Icon="Remove" Foreground="{x:Static local:PencilPalette.Danger}" ToolTip="선택 해제" AutomationProperties.Name="{Binding Name, StringFormat={}{0} 선택 해제}" Click="CardRemove_OnClick"/>
    </Grid>
   </local:PencilBorder>
  </DataTemplate>
 </ResourceDictionary>
 </UserControl.Resources>
 <Grid Margin="28,24">
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
   <Grid><Grid.RowDefinitions><RowDefinition x:Name="InstalledRow" Height="4*" MinHeight="165"/><RowDefinition Height="18"/><RowDefinition x:Name="SelectedRow" Height="3*" MinHeight="135"/></Grid.RowDefinitions>
    <GridSplitter x:Name="LibrarySplitter" Grid.Row="1" Height="12" HorizontalAlignment="Stretch" VerticalAlignment="Center" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Background="Transparent" DragCompleted="Splitter_OnDragCompleted" KeyUp="Splitter_OnKeyUp" Cursor="SizeNS">
     <GridSplitter.Template><ControlTemplate TargetType="GridSplitter"><Grid Background="Transparent"><local:PencilBorder x:Name="Grip" Width="40" Height="3" BorderBrush="{x:Static local:PencilPalette.Line}" BorderThickness="1" VerticalAlignment="Center" HorizontalAlignment="Center"/></Grid><ControlTemplate.Triggers>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Grip" Property="BorderBrush" Value="{x:Static local:PencilPalette.Accent}"/></Trigger>
      <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsEnabled" Value="True"/></MultiTrigger.Conditions><Setter TargetName="Grip" Property="BorderBrush" Value="{x:Static local:PencilPalette.Emphasis}"/></MultiTrigger>
     </ControlTemplate.Triggers></ControlTemplate></GridSplitter.Template>
    </GridSplitter>
    <local:PencilBorder Background="{x:Static local:PencilPalette.Surface}" BorderBrush="{x:Static local:PencilPalette.Line}" BorderThickness="1" CornerRadius="14" Padding="16">
     <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel Margin="3,0,3,12"><ComboBox x:Name="InstalledSort" DockPanel.Dock="Right" Width="112" Padding="6,4" SelectionChanged="Sort_OnChanged" ToolTip="설치됨 정렬" AutomationProperties.Name="설치됨 정렬"/><TextBlock Text="설치됨" FontSize="24" VerticalAlignment="Center"/></DockPanel>
      <ListBox x:Name="InstalledList" Grid.Row="1" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemTemplate="{StaticResource MascotCard}" SelectionChanged="Installed_OnSelectionChanged" PreviewMouseLeftButtonDown="List_OnMouseDown" PreviewMouseMove="List_OnMouseMove" MouseDoubleClick="Installed_OnDoubleClick">
       <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
      </ListBox>
      <Button x:Name="DeleteButton" Grid.Row="2" Content="삭제" local:Pencil.Icon="Delete" Foreground="{x:Static local:PencilPalette.Danger}" Margin="3,12,3,0" HorizontalAlignment="Right" Click="Delete_OnClick"/>
     </Grid>
    </local:PencilBorder>
    <local:PencilBorder x:Name="DropZone" Grid.Row="2" Background="{x:Static local:PencilPalette.Surface}" BorderBrush="{x:Static local:PencilPalette.Line}" BorderThickness="1" CornerRadius="14" Padding="16" AllowDrop="True" DragOver="Selected_OnDragOver" DragLeave="Selected_OnDragLeave" Drop="Selected_OnDrop">
     <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <TextBlock Text="선택됨" FontSize="24" Margin="3,0,3,12"/>
      <ListBox x:Name="SelectedList" Grid.Row="1" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemTemplate="{StaticResource SelectedMascotCard}" SelectionChanged="Selected_OnSelectionChanged" PreviewMouseLeftButtonDown="List_OnMouseDown" PreviewMouseMove="List_OnMouseMove" MouseDoubleClick="Selected_OnDoubleClick">
       <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
      </ListBox>
     </Grid>
    </local:PencilBorder>
   </Grid>
   <local:PencilBorder Grid.Column="2" Background="{x:Static local:PencilPalette.Surface}" BorderBrush="{x:Static local:PencilPalette.Line}" BorderThickness="1" CornerRadius="14" Padding="20">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
     <local:PencilBorder x:Name="PreviewSurface" Background="{x:Static local:PencilPalette.Inset}" CornerRadius="12" Height="194" Margin="0,0,0,14">
      <Grid><Image x:Name="PreviewImage" Margin="12" Stretch="Uniform"/><MediaElement x:Name="PreviewVideo" Visibility="Collapsed" LoadedBehavior="Manual" UnloadedBehavior="Close" Stretch="Uniform" IsMuted="True"/><TextBlock x:Name="PreviewError" TextWrapping="Wrap" Margin="16" VerticalAlignment="Center" TextAlignment="Center" Visibility="Collapsed"/></Grid>
     </local:PencilBorder>
     <TextBlock x:Name="DetailName" FontSize="26"/>
     <DockPanel Margin="0,12,0,12"><Button x:Name="StateSettingsButton" DockPanel.Dock="Right" Content="상태별 설정" local:Pencil.Icon="Settings" Padding="10,6" Click="StateSettings_OnClick"/><TextBlock x:Name="ScopeLabel" Text="전체" VerticalAlignment="Center"/></DockPanel>
     <ComboBox x:Name="PreviewState" Visibility="Collapsed" Margin="0,0,0,16" SelectionChanged="PreviewState_OnChanged"/>
     <StackPanel x:Name="EditorPanel">
      <local:NumericDragInput x:Name="VolumeInput" Label="볼륨" Icon="Volume" Minimum="0" Maximum="2" DisplayScale="100" UnitsPerPixel=".5" Suffix="%" Margin="0,0,0,12" ValueCommitted="Volume_OnChanged"/>
      <local:NumericDragInput x:Name="SpeedInput" Label="재생 속도" Icon="Speed" Minimum=".25" Maximum="3" DecimalPlaces="2" UnitsPerPixel=".01" Suffix="×" Margin="0,0,0,16" ValueCommitted="Speed_OnChanged"/>
      <local:NumericDragInput x:Name="DurationInput" Label="이미지 재생시간" Icon="Duration" Visibility="Collapsed" IsEnabled="False" Minimum="0" Maximum="600000" DisplayScale=".001" DecimalPlaces="1" UnitsPerPixel=".1" Suffix="초" Margin="0,0,0,16" ValueCommitted="Duration_OnChanged"/>
      <WrapPanel x:Name="StatePlaybackOptions" Visibility="Collapsed" Margin="0,0,0,12"><CheckBox x:Name="PlayCheck" Content="재생" local:Pencil.Icon="Play" Margin="0,0,12,0" Click="Play_OnClick"/><CheckBox x:Name="LoopCheck" Content="반복" local:Pencil.Icon="Loop" Click="Loop_OnClick"/></WrapPanel>
      <Button x:Name="PositionButton" Content="위치 선택" local:Pencil.Icon="Position" Margin="0,8,0,16" Click="Position_OnClick"/>
      <Button x:Name="TestButton" Content="테스트" local:Pencil.Icon="Play" AutomationProperties.Name="테스트" Click="Test_OnClick" Background="{x:Static local:PencilPalette.Accent}" Foreground="{x:Static local:PencilPalette.OnButton}" BorderBrush="{x:Static local:PencilPalette.Accent}"/>
      <Button x:Name="ResetSettingsButton" Content="설정 초기화" local:Pencil.Icon="Reset" Background="{x:Static local:PencilPalette.OrangeSurface}" Foreground="{x:Static local:PencilPalette.OrangeInk}" BorderBrush="{x:Static local:PencilPalette.OrangeLine}" Margin="0,12,0,0" Click="ResetSettings_OnClick"/>
     </StackPanel>
    </StackPanel></ScrollViewer>
   </local:PencilBorder>
  </Grid>
  <Grid x:Name="StudioFooter" Grid.Row="1" Margin="0,20,0,0">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock x:Name="Feedback" FontFamily="{x:Static local:PencilFonts.Numbers}" FontSize="12" VerticalAlignment="Center" TextAlignment="Right" Margin="0,0,20,0" Foreground="{x:Static local:PencilPalette.Muted}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
   <StackPanel x:Name="FooterActions" Grid.Column="1" Orientation="Horizontal"><Button x:Name="RegisterButton" Content="마스코트 등록" local:Pencil.Icon="Add" Click="Register_OnClick" Background="{x:Static local:PencilPalette.Button}" Foreground="{x:Static local:PencilPalette.OnButton}" BorderBrush="{x:Static local:PencilPalette.Button}"/><Button x:Name="AppSettingsButton" Content="설정" local:Pencil.Icon="Settings" Click="Settings_OnClick" Margin="10,0,0,0"/></StackPanel>
  </Grid>
 </Grid>
</UserControl>
