<UserControl x:Class="CodexMascot.App.LibraryDashboard"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:CodexMascot.App"
 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
 mc:Ignorable="d" d:DesignWidth="1220" d:DesignHeight="860"
 d:DataContext="{d:DesignInstance Type=local:LibraryDashboardDesignData, IsDesignTimeCreatable=True}"
 Background="{Binding Paper, Source={x:Static local:PencilPalette.Current}}" Foreground="{Binding Ink, Source={x:Static local:PencilPalette.Current}}" FontFamily="{x:Static local:PencilFonts.Handwriting}" FontSize="20" PreviewKeyDown="History_OnKeyDown">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="PencilTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="CardAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Width" Value="24"/>
                <Setter Property="Height" Value="24"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="2"/>
                <Setter Property="FontSize" Value="18"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="VerticalAlignment" Value="Top"/>
            </Style>
            <Style TargetType="ListBoxItem">
                <Setter Property="Margin" Value="5"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <local:PencilBorder x:Name="Card" Background="{Binding Surface, Source={x:Static local:PencilPalette.Current}}" BorderBrush="{Binding Line, Source={x:Static local:PencilPalette.Current}}" BorderThickness="1" CornerRadius="12" Padding="10">
                                <ContentPresenter/>
                            </local:PencilBorder>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Card" Property="BorderBrush" Value="{Binding Accent, Source={x:Static local:PencilPalette.Current}}"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="Card" Property="BorderBrush" Value="{Binding Accent, Source={x:Static local:PencilPalette.Current}}"/>
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="True"/>
                                        <Condition Property="IsEnabled" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="Card" Property="BorderBrush" Value="{Binding Emphasis, Source={x:Static local:PencilPalette.Current}}"/>
                                </MultiTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="CardBody" TargetType="local:PencilBorder">
                <Setter Property="Width" Value="126"/>
                <Setter Property="Height" Value="126"/>
                <Setter Property="Background" Value="{Binding Inset, Source={x:Static local:PencilPalette.Current}}"/>
                <Setter Property="BorderBrush" Value="{Binding Line, Source={x:Static local:PencilPalette.Current}}"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Style>
            <!-- 이름 배경 박스: Margin=위치, Height/Width=크기, Background 앞 두 자리=불투명도.
                 설치됨과 선택됨에 함께 적용됩니다. Width가 Auto이면 카드 너비를 채웁니다. -->
            <Style x:Key="CardCaptionBackground" TargetType="Border">
                <Setter Property="VerticalAlignment" Value="Bottom"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="Margin" Value="5,0,5,7"/>
                <Setter Property="Height" Value="30"/>
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Background" Value="{Binding Badge, Source={x:Static local:PencilPalette.Current}}"/>
                <Setter Property="Panel.ZIndex" Value="1"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                        <DataTrigger.EnterActions>
                            <BeginStoryboard><Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25"/>
                            </Storyboard></BeginStoryboard>
                        </DataTrigger.EnterActions>
                        <DataTrigger.ExitActions>
                            <BeginStoryboard><Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.25"/>
                            </Storyboard></BeginStoryboard>
                        </DataTrigger.ExitActions>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="CardCaption" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="TextAlignment" Value="Center"/>
                <Setter Property="Padding" Value="5,0"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                <Setter Property="Panel.ZIndex" Value="1"/>
            </Style>
            <Style x:Key="CardImage" TargetType="Image">
                <Setter Property="Stretch" Value="Uniform"/>
                <Setter Property="RenderTransformOrigin" Value=".5,.5"/>
                <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality"/>
                <Setter Property="RenderTransform">
                    <Setter.Value>
                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"/>
                            <Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"/>
                        </MultiDataTrigger.Conditions>
                        <MultiDataTrigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.15" Duration="0:0:0.12"/>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.15" Duration="0:0:0.12"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </MultiDataTrigger.EnterActions>
                        <MultiDataTrigger.ExitActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.12"/>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.12"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </MultiDataTrigger.ExitActions>
                    </MultiDataTrigger>
                </Style.Triggers>
            </Style>
            <DataTemplate x:Key="MascotCard">
                <local:PencilBorder x:Name="CardBody" Style="{StaticResource CardBody}">
                    <Grid ClipToBounds="True">
                        <Image Source="{Binding Thumbnail}" Style="{StaticResource CardImage}"/>
                        <Border x:Name="CardCaptionBackground" Style="{StaticResource CardCaptionBackground}">
                            <TextBlock x:Name="CardCaption" Style="{StaticResource CardCaption}" Text="{Binding Name}" ToolTip="{Binding Name}"/>
                        </Border>
                        <Button x:Name="CardAddButton" Panel.ZIndex="2" Style="{StaticResource CardAction}" Content="" local:Pencil.Icon="Add" Foreground="{Binding Accent, Source={x:Static local:PencilPalette.Current}}" ToolTip="{local:Loc Key=LB73ACCCA8A4A}" AutomationProperties.Name="{Binding Name, StringFormat={local:Loc Key=L47E781C43156}}" Click="CardAdd_OnClick"/>
                    </Grid>
                </local:PencilBorder>
            </DataTemplate>
            <DataTemplate x:Key="SelectedMascotCard">
                <local:PencilBorder x:Name="CardBody" Style="{StaticResource CardBody}">
                    <Grid ClipToBounds="True">
                        <Image Source="{Binding Thumbnail}" Style="{StaticResource CardImage}"/>
                        <Border x:Name="CardCaptionBackground" Style="{StaticResource CardCaptionBackground}">
                            <TextBlock x:Name="CardCaption" Style="{StaticResource CardCaption}" Text="{Binding Name}" ToolTip="{Binding Name}"/>
                        </Border>
                        <Button x:Name="CardRemoveButton" Panel.ZIndex="2" Style="{StaticResource CardAction}" Content="" local:Pencil.Icon="Remove" Foreground="{Binding Danger, Source={x:Static local:PencilPalette.Current}}" ToolTip="{local:Loc Key=L9AC3A0BEBB2F}" AutomationProperties.Name="{Binding Name, StringFormat={local:Loc Key=LB61B4A6DCFF5}}" Click="CardRemove_OnClick"/>
                    </Grid>
                </local:PencilBorder>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="InstalledRow" Height="4*" MinHeight="165"/>
                    <RowDefinition Height="18"/>
                    <RowDefinition x:Name="SelectedRow" Height="3*" MinHeight="135"/>
                </Grid.RowDefinitions>
                <GridSplitter x:Name="LibrarySplitter" Grid.Row="1" Height="12" HorizontalAlignment="Stretch" VerticalAlignment="Center" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Background="Transparent" DragCompleted="Splitter_OnDragCompleted" KeyUp="Splitter_OnKeyUp" Cursor="SizeNS">
                    <GridSplitter.Template>
                        <ControlTemplate TargetType="GridSplitter">
                            <Grid Background="Transparent">
                                <local:PencilBorder x:Name="Grip" Width="40" Height="3" BorderBrush="{Binding Line, Source={x:Static local:PencilPalette.Current}}" BorderThickness="1" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Grip" Property="BorderBrush" Value="{Binding Accent, Source={x:Static local:PencilPalette.Current}}"/>
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="True"/>
                                        <Condition Property="IsEnabled" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="Grip" Property="BorderBrush" Value="{Binding Emphasis, Source={x:Static local:PencilPalette.Current}}"/>
                                </MultiTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </GridSplitter.Template>
                </GridSplitter>
                <local:PencilBorder Background="{Binding Surface, Source={x:Static local:PencilPalette.Current}}" BorderBrush="{Binding Line, Source={x:Static local:PencilPalette.Current}}" BorderThickness="1" CornerRadius="14" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DockPanel Margin="3,0,3,12">
                            <ComboBox x:Name="InstalledSort" DockPanel.Dock="Right" Width="112" Padding="6,4" SelectionChanged="Sort_OnChanged" ToolTip="{local:Loc Key=L72911686BE6A}" AutomationProperties.Name="{local:Loc Key=L72911686BE6A}"/>
                            <TextBlock Text="{local:Loc Key=LD1C4F4F5FF72}" FontSize="24" VerticalAlignment="Center"/>
                        </DockPanel>
                        <ListBox x:Name="InstalledList" d:ItemsSource="{Binding Installed}" Grid.Row="1" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemTemplate="{StaticResource MascotCard}" SelectionChanged="Installed_OnSelectionChanged" PreviewMouseLeftButtonDown="List_OnMouseDown" PreviewMouseMove="List_OnMouseMove" MouseDoubleClick="Installed_OnDoubleClick">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>
                        <Button x:Name="DeleteButton" Grid.Row="2" Content="{local:Loc Key=L6139B6C3ED73}" local:Pencil.Icon="Delete" Foreground="{Binding Danger, Source={x:Static local:PencilPalette.Current}}" Margin="3,12,3,0" HorizontalAlignment="Right" Click="Delete_OnClick"/>
                    </Grid>
                </local:PencilBorder>
                <local:PencilBorder x:Name="DropZone" Grid.Row="2" Background="{Binding Surface, Source={x:Static local:PencilPalette.Current}}" BorderBrush="{Binding Line, Source={x:Static local:PencilPalette.Current}}" BorderThickness="1" CornerRadius="14" Padding="16" AllowDrop="True" DragOver="Selected_OnDragOver" DragLeave="Selected_OnDragLeave" Drop="Selected_OnDrop">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="{local:Loc Key=L3622AD893C69}" FontSize="24" Margin="3,0,3,12"/>
                        <ListBox x:Name="SelectedList" d:ItemsSource="{Binding Selected}" Grid.Row="1" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemTemplate="{StaticResource SelectedMascotCard}" SelectionChanged="Selected_OnSelectionChanged" PreviewMouseLeftButtonDown="List_OnMouseDown" PreviewMouseMove="List_OnMouseMove" MouseDoubleClick="Selected_OnDoubleClick">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>
                    </Grid>
                </local:PencilBorder>
            </Grid>
            <local:PencilBorder Grid.Column="2" Background="{Binding Surface, Source={x:Static local:PencilPalette.Current}}" BorderBrush="{Binding Line, Source={x:Static local:PencilPalette.Current}}" BorderThickness="1" CornerRadius="14" Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <local:PencilBorder x:Name="PreviewSurface" Background="{Binding Inset, Source={x:Static local:PencilPalette.Current}}" CornerRadius="12" Height="194" Margin="0,0,0,14">
                            <Grid>
                                <Image x:Name="PreviewImage" d:Source="{Binding Preview}" Margin="12" Stretch="Uniform"/>
                                <MediaElement x:Name="PreviewVideo" Visibility="Collapsed" LoadedBehavior="Manual" UnloadedBehavior="Close" Stretch="Uniform" IsMuted="True"/>
                                <TextBlock x:Name="PreviewError" TextWrapping="Wrap" Margin="16" VerticalAlignment="Center" TextAlignment="Center" Visibility="Collapsed"/>
                            </Grid>
                        </local:PencilBorder>
                        <TextBlock x:Name="DetailName" d:Text="MasCat" FontSize="26"/>
                        <DockPanel Margin="0,12,0,12">
                            <Button x:Name="StateSettingsButton" DockPanel.Dock="Right" Content="{local:Loc Key=L997528D7352F}" local:Pencil.Icon="Settings" Padding="10,6" Click="StateSettings_OnClick"/>
                            <TextBlock x:Name="ScopeLabel" Text="{local:Loc Key=LA4B69FAF0C11}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <ComboBox x:Name="PreviewState" Visibility="Collapsed" Margin="0,0,0,16" SelectionChanged="PreviewState_OnChanged"/>
                        <StackPanel x:Name="EditorPanel">
                            <local:NumericDragInput x:Name="VolumeInput" Label="{local:Loc Key=LBFDBCE6891E7}" Icon="Volume" ShowValueFill="True" Minimum="0" Maximum="2" DisplayScale="100" UnitsPerPixel=".5" Suffix="%" Margin="0,0,0,12" ValueCommitted="Volume_OnChanged"/>
                            <local:NumericDragInput x:Name="SpeedInput" Label="{local:Loc Key=L086B74C4B4D5}" Icon="Speed" ShowValueFill="True" Minimum=".25" Maximum="3" DecimalPlaces="2" UnitsPerPixel=".01" Suffix="×" Margin="0,0,0,16" ValueCommitted="Speed_OnChanged"/>
                            <local:NumericDragInput x:Name="DurationInput" Label="{local:Loc Key=LE856A7DE410B}" Icon="Duration" Visibility="Collapsed" IsEnabled="False" Minimum="0" Maximum="600000" DisplayScale=".001" DecimalPlaces="1" UnitsPerPixel=".1" Suffix="{local:Loc Key=L1FD639E1EC96}" Margin="0,0,0,16" ValueCommitted="Duration_OnChanged"/>
                            <WrapPanel x:Name="StatePlaybackOptions" Visibility="Collapsed" Margin="0,0,0,12">
                                <CheckBox x:Name="PlayCheck" Content="{local:Loc Key=LD43A776C5E28}" local:Pencil.Icon="Play" Margin="0,0,12,0" Click="Play_OnClick"/>
                                <CheckBox x:Name="LoopCheck" Content="{local:Loc Key=L58902391B937}" local:Pencil.Icon="Loop" Click="Loop_OnClick"/>
                                <CheckBox x:Name="HoldCheck" Content="{local:Loc Key=L781C2FA885F7}" Margin="12,0,0,0" Click="Hold_OnClick"/>
                            </WrapPanel>
                            <CheckBox x:Name="TaskbarCheck" Content="{local:Loc Key=L050CA8B451E8}" Margin="0,0,0,12" Click="Taskbar_OnClick"
                                      ToolTip="{local:Loc Key=L5CEF6AB1549A}"/>
                            <Button x:Name="PositionButton" Content="{local:Loc Key=L76A4C8BB26AD}" local:Pencil.Icon="Position" Margin="0,8,0,16" Click="Position_OnClick"/>
                            <Button x:Name="TestButton" Content="{local:Loc Key=LBC19D3B3C9E4}" local:Pencil.Icon="Play" AutomationProperties.Name="{local:Loc Key=LBC19D3B3C9E4}" Click="Test_OnClick" Background="{Binding AccentButton, Source={x:Static local:PencilPalette.Current}}" Foreground="{Binding OnButton, Source={x:Static local:PencilPalette.Current}}" BorderBrush="{Binding AccentButton, Source={x:Static local:PencilPalette.Current}}"/>
                            <Button x:Name="ResetSettingsButton" Content="{local:Loc Key=LB81DEEE16407}" local:Pencil.Icon="Reset" Background="{Binding OrangeSurface, Source={x:Static local:PencilPalette.Current}}" Foreground="{Binding OrangeInk, Source={x:Static local:PencilPalette.Current}}" BorderBrush="{Binding OrangeLine, Source={x:Static local:PencilPalette.Current}}" Margin="0,12,0,0" Click="ResetSettings_OnClick"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </local:PencilBorder>
        </Grid>
        <Grid x:Name="StudioFooter" Grid.Row="1" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Canvas IsHitTestVisible="False" Focusable="False" Panel.ZIndex="-1">
                <Image x:Name="FooterMascotArt" Source="{Binding Logo, Source={x:Static local:PencilPalette.Current}}" Width="180" Height="180" Canvas.Left="-46" Canvas.Bottom="-24" Stretch="Uniform" Opacity="0.3" IsHitTestVisible="False" Focusable="False" RenderOptions.BitmapScalingMode="HighQuality" Canvas.Top="-90" HorizontalAlignment="Left" VerticalAlignment="Top"/>
            </Canvas>
            <TextBlock x:Name="Feedback" FontFamily="{x:Static local:PencilFonts.Numbers}" FontSize="12" VerticalAlignment="Center" TextAlignment="Right" Margin="170,0,20,0" Foreground="{Binding Muted, Source={x:Static local:PencilPalette.Current}}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            <StackPanel x:Name="FooterActions" Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="RegisterButton" Content="{local:Loc Key=LB6230F958A83}" local:Pencil.Icon="Add" Click="Register_OnClick" Background="{Binding Button, Source={x:Static local:PencilPalette.Current}}" Foreground="{Binding OnButton, Source={x:Static local:PencilPalette.Current}}" BorderBrush="{Binding Button, Source={x:Static local:PencilPalette.Current}}"/>
                <Button x:Name="ProjectSelectionButton" Content="{Binding [감시 프로젝트 선택], Source={x:Static local:Loc.Current}}" local:Pencil.Icon="Folder" Click="Projects_OnClick" Margin="10,0,0,0"/>
                <Button x:Name="AppSettingsButton" Content="{local:Loc Key=L115BCED49291}" local:Pencil.Icon="Settings" Click="Settings_OnClick" Margin="10,0,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
