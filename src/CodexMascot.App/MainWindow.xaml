<Window x:Class="CodexMascot.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:CodexMascot.App"
 Title="{x:Static local:AppBrand.Name}" Width="1220" Height="900" MinWidth="1020" MinHeight="760"
 Background="{Binding Paper, Source={x:Static local:PencilPalette.Current}}" Foreground="{Binding Ink, Source={x:Static local:PencilPalette.Current}}" WindowStartupLocation="CenterScreen">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="PencilTheme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
 <Grid x:Name="ShellRoot">
 <local:LibraryDashboard x:Name="Dashboard"/>
 <Grid x:Name="WorkspacePanel" Margin="0,0,10,0" MinHeight="600" TextElement.FontSize="16" Visibility="Collapsed">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <local:PencilBorder Grid.Row="1" Padding="14" Background="{Binding Surface, Source={x:Static local:PencilPalette.Current}}" CornerRadius="12" Margin="0,0,0,12">
   <StackPanel><TextBlock x:Name="StatusTextBlock" Text="{local:Loc Key=LB3E37D48D233}" FontSize="21" FontWeight="SemiBold"/>
    <TextBlock x:Name="ConnectionTextBlock" TextWrapping="Wrap" Foreground="{Binding Accent, Source={x:Static local:PencilPalette.Current}}" Margin="0,5,0,0"/>
   </StackPanel>
  </local:PencilBorder>
  <TabControl Grid.Row="2" Background="{Binding Inset, Source={x:Static local:PencilPalette.Current}}" BorderBrush="{Binding Line, Source={x:Static local:PencilPalette.Current}}">
   <TabItem Header="{local:Loc Key=LB062E94204B7}">
    <Grid Margin="12">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel>
      <TextBlock Text="{local:Loc Key=L7FFB0C9FEA0D}" Foreground="{Binding Ink, Source={x:Static local:PencilPalette.Current}}" TextWrapping="Wrap"/>
      <TextBlock Text="{local:Loc Key=LBA7E28575B3F}" Foreground="{Binding Muted, Source={x:Static local:PencilPalette.Current}}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,8"/>
      <DockPanel><TextBlock Text="{local:Loc Key=LBD72EBD91938}" Foreground="{Binding Ink, Source={x:Static local:PencilPalette.Current}}" Width="100" VerticalAlignment="Center"/><Button DockPanel.Dock="Right" Content="{local:Loc Key=LAB437C2C5679}" local:Pencil.Icon="Folder" Click="BrowseHome_OnClick"/><TextBox x:Name="CodexHomeTextBox" ToolTip="{local:Loc Key=L22298BA1CA74}"/></DockPanel>
      <DockPanel><TextBlock Text="{local:Loc Key=LC6AD5CAD8A4A}" Foreground="{Binding Ink, Source={x:Static local:PencilPalette.Current}}" Width="100" VerticalAlignment="Center"/><Button DockPanel.Dock="Right" Content="{local:Loc Key=LAB437C2C5679}" local:Pencil.Icon="Folder" Click="BrowseClaudeHome_OnClick"/><TextBox x:Name="ClaudeHomeTextBox" ToolTip="{local:Loc Key=LECC6F3D80AC4}"/></DockPanel>
     </StackPanel>
     <WrapPanel Grid.Row="1" Margin="0,5">
      <Button x:Name="MonitorButton" Content="{local:Loc Key=L73098D68A159}" local:Pencil.Icon="Reset" Click="Monitor_OnClick" Background="{Binding Selected, Source={x:Static local:PencilPalette.Current}}"/>
      <Button Content="{local:Loc Key=L07DAADEF9DEB}" local:Pencil.Icon="Stop" Click="PauseMonitor_OnClick"/>
     </WrapPanel>
     <TextBlock Grid.Row="2" x:Name="HookTextBlock" Text="{local:Loc Key=LA7C945902AC5}" Foreground="{Binding Muted, Source={x:Static local:PencilPalette.Current}}" TextWrapping="Wrap" Margin="0,0,0,10"/>
     <ListView Grid.Row="3" x:Name="JobsListView" Focusable="False" IsTabStop="False" Background="{Binding Surface, Source={x:Static local:PencilPalette.Current}}" Foreground="{Binding Ink, Source={x:Static local:PencilPalette.Current}}" BorderBrush="{Binding Line, Source={x:Static local:PencilPalette.Current}}">
      <ListView.ItemContainerStyle>
       <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
        <Setter Property="Focusable" Value="False"/><Setter Property="IsHitTestVisible" Value="False"/>
       </Style>
      </ListView.ItemContainerStyle>
      <ListView.Resources>
       <Style TargetType="GridViewColumnHeader">
        <Setter Property="Background" Value="{Binding Inset, Source={x:Static local:PencilPalette.Current}}"/>
        <Setter Property="Foreground" Value="{Binding Ink, Source={x:Static local:PencilPalette.Current}}"/>
        <Setter Property="BorderBrush" Value="{Binding Line, Source={x:Static local:PencilPalette.Current}}"/>
        <Setter Property="Padding" Value="6,4"/><Setter Property="Focusable" Value="False"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="GridViewColumnHeader">
         <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,1,1" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
         </Border>
        </ControlTemplate></Setter.Value></Setter>
       </Style>
      </ListView.Resources>
      <ListView.View><GridView AllowsColumnReorder="False">
       <GridViewColumn Header="{local:Loc Key=LE10195A1239F}" DisplayMemberBinding="{Binding State}" Width="110"/>
       <GridViewColumn Header="{local:Loc Key=L1F46C3B8F2E2}" Width="205"><GridViewColumn.CellTemplate><DataTemplate>
        <TextBlock Text="{Binding Project}" ToolTip="{Binding FullPath}" TextTrimming="CharacterEllipsis"/>
       </DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
       <GridViewColumn Header="{local:Loc Key=L56BA41779428}" DisplayMemberBinding="{Binding Updated}" Width="90"/>
       <GridViewColumn Header="{local:Loc Key=L049D3529FC35}" DisplayMemberBinding="{Binding Source}" Width="85"/>
       <GridViewColumn Header="{local:Loc Key=L8C3F651D3083}" DisplayMemberBinding="{Binding Message}" Width="290"/>
      </GridView></ListView.View>
     </ListView>
    </Grid>
   </TabItem>
  </TabControl>
  <TextBlock Grid.Row="3" x:Name="LogTextBlock" Foreground="{Binding Muted, Source={x:Static local:PencilPalette.Current}}" TextWrapping="Wrap" Margin="4,10,4,0"/>
 </Grid>
 </Grid>
</Window>
