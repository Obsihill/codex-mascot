<Window x:Class="CodexMascot.App.OverlayWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 AllowsTransparency="True" Background="Transparent" WindowStyle="None"
 ShowInTaskbar="False" ShowActivated="False" Topmost="True" Width="260" Height="280">
 <Grid Background="Transparent" Margin="8">
  <Image x:Name="MascotImage" Margin="0,18,0,0" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
  <Border x:Name="FallbackCard" Background="#E6233247" CornerRadius="24" Visibility="Collapsed" Margin="12,30,12,12">
   <StackPanel VerticalAlignment="Center"><TextBlock x:Name="FallbackEmoji" Text="★" FontSize="68" Foreground="#70D6FF" HorizontalAlignment="Center"/>
    <TextBlock x:Name="FallbackText" Foreground="White" FontSize="16" TextAlignment="Center"/></StackPanel>
  </Border>
  <Button Content="×" Width="28" Height="28" Padding="0" Margin="0" HorizontalAlignment="Right" VerticalAlignment="Top" Click="Dismiss_OnClick" ToolTip="알림 닫기"/>
 </Grid>
</Window>
