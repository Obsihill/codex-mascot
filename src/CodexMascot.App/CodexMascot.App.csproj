<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>AgentMascot</AssemblyName>
    <RootNamespace>CodexMascot.App</RootNamespace>
    <AssemblyTitle>Agent Mascot</AssemblyTitle>
    <Product>Agent Mascot</Product>
    <Description>Desktop mascot notifications for Codex and Claude</Description>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <LangVersion>latest</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Branding\App.ico</ApplicationIcon>
    <Version>0.2.3</Version>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Localization\en.json" />
    <Resource Include="Fonts\NanumPenScript-Regular.ttf" />
    <Resource Include="Branding\App.ico" />
    <Resource Include="Branding\TrayDark.ico" />
    <Resource Include="Branding\TrayLight.ico" />
    <Resource Include="Branding\mas-cat-black.png" />
    <Resource Include="Branding\mas-cat.png" />
    <Resource Include="..\..\assets\images\main.png" Link="Design\original.png" />
    <Resource Include="..\..\assets\MasCat\main.png" Link="Design\mascat.png" />
    <Content Include="Fonts\OFL.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <InternalsVisibleTo Include="CodexMascot.App.Tests" />
    <ProjectReference Include="..\CodexMascot.Core\CodexMascot.Core.csproj" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <Content Include="..\..\assets\**\*" Link="assets\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\integration\**\*" Link="integration\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\README.md" Link="README.md" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\VALIDATION.md" Link="VALIDATION.md" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
