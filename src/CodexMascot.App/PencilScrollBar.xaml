<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:CodexMascot.App">
 <Style x:Key="PencilScrollArrow" TargetType="RepeatButton">
  <Setter Property="Focusable" Value="False"/><Setter Property="IsTabStop" Value="False"/>
  <Setter Property="Background" Value="{Binding Surface, Source={x:Static local:PencilPalette.Current}}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton">
   <local:PencilBorder x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{Binding Line, Source={x:Static local:PencilPalette.Current}}" BorderThickness="1" Margin="1">
    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
   </local:PencilBorder>
   <ControlTemplate.Triggers>
    <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsEnabled" Value="True"/></MultiTrigger.Conditions><Setter TargetName="Box" Property="BorderBrush" Value="{Binding Emphasis, Source={x:Static local:PencilPalette.Current}}"/></MultiTrigger>
    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{Binding Emphasis, Source={x:Static local:PencilPalette.Current}}"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Box" Property="Opacity" Value=".4"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="PencilScrollPage" TargetType="RepeatButton">
  <Setter Property="Focusable" Value="False"/><Setter Property="IsTabStop" Value="False"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="PencilScrollThumb" TargetType="Thumb">
  <Setter Property="Focusable" Value="False"/><Setter Property="MinWidth" Value="10"/><Setter Property="MinHeight" Value="10"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb">
   <local:PencilBorder x:Name="Box" Background="{Binding Surface, Source={x:Static local:PencilPalette.Current}}" BorderBrush="{Binding Line, Source={x:Static local:PencilPalette.Current}}" BorderThickness="1" Margin="1">
    <Path Data="M0,0 L6,.3 M0,3 L6,2.7" Stroke="{Binding Muted, Source={x:Static local:PencilPalette.Current}}" StrokeThickness=".7" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
   </local:PencilBorder>
   <ControlTemplate.Triggers>
    <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsEnabled" Value="True"/></MultiTrigger.Conditions><Setter TargetName="Box" Property="BorderBrush" Value="{Binding Emphasis, Source={x:Static local:PencilPalette.Current}}"/></MultiTrigger>
    <Trigger Property="IsDragging" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{Binding Emphasis, Source={x:Static local:PencilPalette.Current}}"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Box" Property="Opacity" Value=".4"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <ControlTemplate x:Key="PencilVerticalScrollBar" TargetType="ScrollBar">
  <Grid Background="Transparent"><Grid.RowDefinitions><RowDefinition Height="16"/><RowDefinition Height="*"/><RowDefinition Height="16"/></Grid.RowDefinitions>
   <RepeatButton x:Name="LineBackward" Style="{StaticResource PencilScrollArrow}" Command="ScrollBar.LineUpCommand">
    <local:PencilIcon Kind="ChevronDown" Width="12" Height="12" RenderTransformOrigin=".5,.5"><local:PencilIcon.RenderTransform><RotateTransform Angle="180"/></local:PencilIcon.RenderTransform></local:PencilIcon>
   </RepeatButton>
   <local:PencilBorder Grid.Row="1" Background="{Binding Inset, Source={x:Static local:PencilPalette.Current}}" BorderBrush="{Binding Line, Source={x:Static local:PencilPalette.Current}}" BorderThickness="1" Margin="2,1" IsHitTestVisible="False"/>
   <Track x:Name="PART_Track" Grid.Row="1" Orientation="Vertical" IsDirectionReversed="True" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ViewportSize="{TemplateBinding ViewportSize}">
    <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource PencilScrollPage}" Command="ScrollBar.PageUpCommand"/></Track.DecreaseRepeatButton>
    <Track.Thumb><Thumb Style="{StaticResource PencilScrollThumb}"/></Track.Thumb>
    <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource PencilScrollPage}" Command="ScrollBar.PageDownCommand"/></Track.IncreaseRepeatButton>
   </Track>
   <RepeatButton x:Name="LineForward" Grid.Row="2" Style="{StaticResource PencilScrollArrow}" Command="ScrollBar.LineDownCommand"><local:PencilIcon Kind="ChevronDown" Width="12" Height="12"/></RepeatButton>
  </Grid>
 </ControlTemplate>
 <ControlTemplate x:Key="PencilHorizontalScrollBar" TargetType="ScrollBar">
  <Grid Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/></Grid.ColumnDefinitions>
   <RepeatButton x:Name="LineBackward" Style="{StaticResource PencilScrollArrow}" Command="ScrollBar.LineLeftCommand">
    <local:PencilIcon Kind="ChevronDown" Width="12" Height="12" RenderTransformOrigin=".5,.5"><local:PencilIcon.RenderTransform><RotateTransform Angle="90"/></local:PencilIcon.RenderTransform></local:PencilIcon>
   </RepeatButton>
   <local:PencilBorder Grid.Column="1" Background="{Binding Inset, Source={x:Static local:PencilPalette.Current}}" BorderBrush="{Binding Line, Source={x:Static local:PencilPalette.Current}}" BorderThickness="1" Margin="1,2" IsHitTestVisible="False"/>
   <Track x:Name="PART_Track" Grid.Column="1" Orientation="Horizontal" IsDirectionReversed="False" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ViewportSize="{TemplateBinding ViewportSize}">
    <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource PencilScrollPage}" Command="ScrollBar.PageLeftCommand"/></Track.DecreaseRepeatButton>
    <Track.Thumb><Thumb Style="{StaticResource PencilScrollThumb}"/></Track.Thumb>
    <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource PencilScrollPage}" Command="ScrollBar.PageRightCommand"/></Track.IncreaseRepeatButton>
   </Track>
   <RepeatButton x:Name="LineForward" Grid.Column="2" Style="{StaticResource PencilScrollArrow}" Command="ScrollBar.LineRightCommand">
    <local:PencilIcon Kind="ChevronDown" Width="12" Height="12" RenderTransformOrigin=".5,.5"><local:PencilIcon.RenderTransform><RotateTransform Angle="-90"/></local:PencilIcon.RenderTransform></local:PencilIcon>
   </RepeatButton>
  </Grid>
 </ControlTemplate>
 <Style TargetType="ScrollBar">
  <Setter Property="Focusable" Value="False"/><Setter Property="IsTabStop" Value="False"/>
  <Setter Property="Width" Value="16"/><Setter Property="MinHeight" Value="48"/>
  <Setter Property="Template" Value="{StaticResource PencilVerticalScrollBar}"/>
  <Style.Triggers>
   <Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="16"/><Setter Property="MinHeight" Value="0"/><Setter Property="MinWidth" Value="48"/><Setter Property="Template" Value="{StaticResource PencilHorizontalScrollBar}"/></Trigger>
  </Style.Triggers>
 </Style>
</ResourceDictionary>
