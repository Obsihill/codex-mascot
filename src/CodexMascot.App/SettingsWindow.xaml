<Window x:Class="CodexMascot.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CodexMascot.App"
        Title="{x:Static local:AppBrand.SettingsTitle}"
        Width="850"
        Height="720"
        MinWidth="780"
        MinHeight="560" FontFamily="{x:Static local:PencilFonts.Handwriting}" FontSize="20"
        Background="{x:Static local:PencilPalette.Paper}"
        Foreground="{x:Static local:PencilPalette.Ink}"
        WindowStartupLocation="CenterOwner">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="PencilTheme.xaml"/></ResourceDictionary.MergedDictionaries>
      <Style x:Key="SettingsTabs" TargetType="TabControl">
       <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
         <TabPanel IsItemsHost="True" Margin="0,0,0,14"/>
         <ContentPresenter Grid.Row="1" ContentSource="SelectedContent"/>
        </Grid>
       </ControlTemplate></Setter.Value></Setter>
      </Style>
    </ResourceDictionary></Window.Resources>
 <Grid x:Name="Root" Margin="18" />
</Window>
