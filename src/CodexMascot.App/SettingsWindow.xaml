<Window x:Class="CodexMascot.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CodexMascot.App"
        Title="Mascot · 공통 알림 설정"
        Width="850"
        Height="650"
        MinWidth="720"
        MinHeight="520"
        Background="{x:Static local:PencilPalette.Paper}"
        Foreground="{x:Static local:PencilPalette.Ink}"
        WindowStartupLocation="CenterOwner">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="PencilTheme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
 <Grid x:Name="Root" Margin="18" />
</Window>
